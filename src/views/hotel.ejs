<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>

    <% if (listing) { const pageUrl=`https://yourdomain.com/hotels/ ${listing.slug}`; const imageUrl=listing.cover_image; const description=listing.description?.substring(0, 160) || '' ; %>

        <title>
            <%= listing.title %> | Hotel in <%= listing.municipality %>
        </title>

        <meta name="description" content="<%= description %>">
        <meta name="keywords"
            content="<%= listing.title %>, <%= listing.municipality %> hotel, Albay accommodation, stay in <%= listing.municipality %>, best hotels Albay">
        <meta name="author" content="Your Website Name">
        <meta name="robots" content="index, follow">
        <link rel="canonical" href="<%= pageUrl %>">

        <meta property="og:type" content="hotel">
        <meta property="og:title" content="<%= listing.title %>">
        <meta property="og:description" content="<%= description %>">
        <meta property="og:url" content="<%= pageUrl %>">
        <meta property="og:image" content="<%= imageUrl %>">
        <meta property="og:site_name" content="Your Website Name">

        <meta name="twitter:card" content="summary_large_image">
        <meta name="twitter:title" content="<%= listing.title %>">
        <meta name="twitter:description" content="<%= description %>">
        <meta name="twitter:image" content="<%= imageUrl %>">

        <script src="https://cdn.tailwindcss.com "></script>
        <script>
            tailwind.config = {
                theme: {
                    extend: {
                        colors: {
                            luxury: {
                                50: '#f8f6f4',
                                100: '#efeae6',
                                200: '#e0d5cd',
                                300: '#cbb8ab',
                                400: '#b59887',
                                500: '#a37d68',
                                600: '#8f6655',
                                700: '#765248',
                                800: '#61443d',
                                900: '#503834',
                            },
                            gold: {
                                400: '#d4af37',
                                500: '#c5a028',
                                600: '#b08d1f',
                            }
                        }
                    }
                }
            }
        </script>
        <script>
            document.addEventListener("DOMContentLoaded", function () {
                const el = document.getElementById('description');
                if (!el) return;

                let text = el.innerHTML || '';

                text = text.replace(/&lt;br\s*\/?&gt;/gi, '<br>');
                text = text.replace(/\r\n/g, '\n');
                text = text.replace(/\n\n+/g, '</p><p class="mt-4">');
                text = text.replace(/\n/g, '<br>');
                text = `<p>${text}</p>`;

                el.innerHTML = text;
            });
        </script>
        <script type="application/ld+json">
        {
        "@context": "https://schema.org ",
        "@type": "Hotel",
        "name": "<%= listing.title %>",
        "description": "<%= description.replace(/"/g, '\\"') %>",
        "image": "<%= imageUrl %>",
        "url": "<%= pageUrl %>",
        "address": {
            "@type": "PostalAddress",
            "addressLocality": "<%= listing.municipality %>",
            "addressRegion": "Albay",
            "addressCountry": "PH"
        },
        "geo": {
            "@type": "GeoCoordinates",
            "latitude": <%= listing.geo_lat || 0 %>,
            "longitude": <%= listing.geo_lng || 0 %>
        },
        "starRating": {
            "@type": "Rating",
            "ratingValue": "<%= listing.rating ? listing.rating.toFixed(1) : '4' %>"
        },
        "priceRange": "<%= listing.pricing_lowest ? '₱' + listing.pricing_lowest : '₱₱₱' %>"<% if (listing.contact_info && listing.contact_info.phone) { %>,
        "telephone": "<%= listing.contact_info.phone %>"<% } %>
        }   
    </script>

        <% } %>

            <style scoped>
                @import url('https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@400;500;600;700&family=Montserrat:wght@300;400;500;600;700&display=swap');

                .font-serif {
                    font-family: 'Cormorant Garamond', serif;
                }

                .font-sans {
                    font-family: 'Montserrat', sans-serif;
                }

                .nav-link {
                    color: inherit;
                    transition: color 0.2s;
                }

                .nav-link:hover {
                    color: #a37d68;
                }

                .mobile-link {
                    display: flex;
                    align-items: center;
                    gap: 0.75rem;
                    transition: color 0.2s;
                }

                .mobile-link:hover {
                    color: #a37d68;
                }

                .footer-title {
                    color: #ffffff;
                    font-weight: 600;
                    margin-bottom: 1rem;
                }

                .footer-list li {
                    color: #94a3b8;
                    font-size: 0.875rem;
                    transition: color 0.2s;
                }

                .footer-list li:hover {
                    color: #ffffff;
                }

                .social-icon {
                    width: 2.25rem;
                    height: 2.25rem;
                    border-radius: 9999px;
                    background-color: #1e293b;
                    display: flex;
                    align-items: center;
                    justify-content: center;
                    font-size: 0.75rem;
                    font-weight: 600;
                    cursor: pointer;
                    transition: background-color 0.2s;
                }

                .social-icon:hover {
                    background-color: #a37d68;
                }

                /* Animations */
                .fade-enter-active,
                .fade-leave-active {
                    transition: opacity 0.2s ease;
                }

                .fade-enter-from,
                .fade-leave-to {
                    opacity: 0;
                }

                .slide-enter-active,
                .slide-leave-active {
                    transition: transform 0.25s ease;
                }

                .slide-enter-from,
                .slide-leave-to {
                    transform: translateX(100%);
                }

                .glass-card {
                    background: rgba(255, 255, 255, 0.95);
                    backdrop-filter: blur(20px);
                    border: 1px solid rgba(255, 255, 255, 0.3);
                }

                .luxury-shadow {
                    box-shadow: 0 25px 50px -12px rgba(143, 102, 85, 0.15);
                }

                .gold-accent {
                    background: linear-gradient(135deg, #d4af37 0%, #b08d1f 100%);
                }

                .marble-pattern {
                    background-image: url("data:image/svg+xml,%3Csvg width='100' height='100' viewBox='0 0 100 100' xmlns='http://www.w3.org/2000/svg'%3E%3Cpath d='M11 18c3.866 0 7-3.134 7-7s-3.134-7-7-7-7 3.134-7 7 3.134 7 7 7zm48 25c3.866 0 7-3.134 7-7s-3.134-7-7-7-7 3.134-7 7 3.134 7 7 7zm-43-7c1.657 0 3-1.343 3-3s-1.343-3-3-3-3 1.343-3 3 1.343 3 3 3zm63 31c1.657 0 3-1.343 3-3s-1.343-3-3-3-3 1.343-3 3 1.343 3 3 3zM34 90c1.657 0 3-1.343 3-3s-1.343-3-3-3-3 1.343-3 3 1.343 3 3 3zm56-76c1.657 0 3-1.343 3-3s-1.343-3-3-3-3 1.343-3 3 1.343 3 3 3zM12 86c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4zm28-65c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4zm23-11c2.76 0 5-2.24 5-5s-2.24-5-5-5-5 2.24-5 5 2.24 5 5 5zm-6 60c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4zm29 22c2.76 0 5-2.24 5-5s-2.24-5-5-5-5 2.24-5 5 2.24 5 5 5zM32 63c2.76 0 5-2.24 5-5s-2.24-5-5-5-5 2.24-5 5 2.24 5 5 5zm57-13c2.76 0 5-2.24 5-5s-2.24-5-5-5-5 2.24-5 5 2.24 5 5 5zm-9-21c1.105 0 2-.895 2-2s-.895-2-2-2-2 .895-2 2 .895 2 2 2zM60 91c1.105 0 2-.895 2-2s-.895-2-2-2-2 .895-2 2 .895 2 2 2zM35 41c1.105 0 2-.895 2-2s-.895-2-2-2-2 .895-2 2 .895 2 2 2zM12 60c1.105 0 2-.895 2-2s-.895-2-2-2-2 .895-2 2 .895 2 2 2z' fill='%239C92AC' fill-opacity='0.03' fill-rule='evenodd'/%3E%3C/svg%3E");
                }
            </style>
</head>

<body class="font-sans bg-luxury-50">
    <% if (listing) { %>
        <div class="bg-luxury-50 min-h-screen marble-pattern">
            <!-- Navigation Overlay -->
            <div
                class="fixed top-0 left-0 right-0 z-50 bg-white/95 backdrop-blur-md border-b border-luxury-100 lg:hidden">
                <div class="px-4 py-3 flex items-center justify-between">
                    <a href="/hotels" class="p-2 hover:bg-luxury-50 rounded-full transition-colors">
                        <svg class="w-5 h-5 text-luxury-800" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                d="M10 19l-7-7m0 0l7-7m-7 7h18"></path>
                        </svg>
                    </a>
                    <h2 class="text-sm font-bold text-luxury-900 truncate max-w-[200px]">
                        <%= listing.title %>
                    </h2>
                    <button class="p-2 hover:bg-luxury-50 rounded-full transition-colors">
                        <svg class="w-5 h-5 text-luxury-800" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z">
                            </path>
                        </svg>
                    </button>
                </div>
            </div>

            <!-- Main Content Area -->
            <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pt-20 lg:pt-12">
                <!-- Breadcrumbs -->
                <nav class="hidden lg:flex items-center gap-2 text-sm text-luxury-500 mb-8">
                    <a href="/" class="hover:text-luxury-700 transition-colors">Home</a>
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
                    </svg>
                    <a href="/hotels" class="hover:text-luxury-700 transition-colors">Hotels</a>
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
                    </svg>
                    <span class="text-luxury-900 font-medium">
                        <%= listing.title %>
                    </span>
                </nav>

                <div class="grid grid-cols-1 lg:grid-cols-12 gap-12">
                    <!-- Left Column: Media & Core Info -->
                    <div class="lg:col-span-8">
                        <!-- Hero Image Gallery Style -->
                        <section
                            class="relative rounded-[2.5rem] overflow-hidden bg-luxury-200 w-full max-h-[75vh] luxury-shadow mb-10 group">
                            
                            <img 
                                src="<%= listing.cover_image %>" 
                                alt="<%= listing.title %>"
                                class="w-full h-auto max-h-[75vh] object-contain md:object-cover transform group-hover:scale-105 transition-transform duration-1000">
                            
                            <div
                                class="absolute inset-0 bg-gradient-to-t from-black/70 via-black/10 to-transparent flex items-end">
                                <div class="p-8 md:p-12 w-full">
                                    <div class="flex flex-wrap items-center gap-3 mb-4">
                                        <span
                                            class="px-4 py-1.5 rounded-full gold-accent text-white text-xs font-bold uppercase tracking-wider shadow-lg">
                                            <%= listing.category || 'Luxury Hotel' %>
                                        </span>
                                        <% if (listing.is_premium) { %>
                                            <span
                                                class="px-4 py-1.5 rounded-full bg-emerald-600 text-white text-xs font-bold uppercase tracking-wider shadow-lg flex items-center gap-1">
                                                <svg class="w-3 h-3" fill="currentColor" viewBox="0 0 20 20"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/></svg>
                                                Premium Stay
                                            </span>
                                        <% } %>
                                    </div>
                                    <h1 class="text-4xl md:text-6xl font-serif font-bold text-white leading-tight tracking-tight">
                                        <%= listing.title %>
                                    </h1>
                                    <div class="flex items-center gap-2 mt-3 text-luxury-200">
                                        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"></path>
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path>
                                        </svg>
                                        <span class="text-lg font-light"><%= listing.municipality %>, Albay</span>
                                    </div>
                                </div>
                            </div>
                        </section>

                        <!-- Quick Stats Row -->
                        <div class="grid grid-cols-2 md:grid-cols-4 gap-4 mb-12">
                            <div
                                class="bg-white p-5 rounded-3xl border border-luxury-100 luxury-shadow flex items-center gap-4 hover:shadow-lg transition-shadow">
                                <div class="w-10 h-10 rounded-2xl bg-luxury-50 flex items-center justify-center">
                                    <svg class="w-5 h-5 text-luxury-600" fill="none" stroke="currentColor"
                                        viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                            d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z">
                                        </path>
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                            d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path>
                                    </svg>
                                </div>
                                <div>
                                    <p class="text-[10px] font-bold text-luxury-400 uppercase tracking-tight">Location
                                    </p>
                                    <p class="text-sm font-bold text-luxury-900">
                                        <%= listing.municipality %>
                                    </p>
                                </div>
                            </div>
                            <div
                                class="bg-white p-5 rounded-3xl border border-luxury-100 luxury-shadow flex items-center gap-4 hover:shadow-lg transition-shadow">
                                <div class="w-10 h-10 rounded-2xl bg-amber-50 flex items-center justify-center">
                                    <svg class="w-5 h-5 text-amber-500 fill-amber-500" fill="currentColor"
                                        viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                            d="M11.049 2.927c.3-.921 1.603-.921 1.902 0l1.519 4.674a1 1 0 00.95.69h4.915c.969 0 1.371 1.24.588 1.81l-3.976 2.888a1 1 0 00-.363 1.118l1.518 4.674c.3.922-.755 1.688-1.538 1.118l-3.976-2.888a1 1 0 00-1.176 0l-3.976 2.888c-.783.57-1.838-.197-1.538-1.118l1.518-4.674a1 1 0 00-.363-1.118l-3.976-2.888c-.784-.57-.38-1.81.588-1.81h4.914a1 1 0 00.951-.69l1.519-4.674z">
                                        </path>
                                    </svg>
                                </div>
                                <div>
                                    <p class="text-[10px] font-bold text-luxury-400 uppercase tracking-tight">Rating</p>
                                    <p class="text-sm font-bold text-luxury-900">
                                        <%= listing.rating ? listing.rating.toFixed(1) : 'N/A' %>
                                    </p>
                                </div>
                            </div>
                            <div
                                class="bg-white p-5 rounded-3xl border border-luxury-100 luxury-shadow flex items-center gap-4 hover:shadow-lg transition-shadow">
                                <div class="w-10 h-10 rounded-2xl bg-emerald-50 flex items-center justify-center">
                                    <svg class="w-5 h-5 text-emerald-600" fill="none" stroke="currentColor"
                                        viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                            d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z">
                                        </path>
                                    </svg>
                                </div>
                                <div>
                                    <p class="text-[10px] font-bold text-luxury-400 uppercase tracking-tight">From/Night
                                    </p>
                                    <p class="text-sm font-bold text-luxury-900">
                                        <%= listing.pricing_lowest ? '₱' + listing.pricing_lowest : 'Contact Us' %>
                                    </p>
                                </div>
                            </div>
                            <div
                                class="bg-white p-5 rounded-3xl border border-luxury-100 luxury-shadow flex items-center gap-4 hover:shadow-lg transition-shadow">
                                <div class="w-10 h-10 rounded-2xl bg-rose-50 flex items-center justify-center">
                                    <svg class="w-5 h-5 text-rose-600" fill="none" stroke="currentColor"
                                        viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                            d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                                    </svg>
                                </div>
                                <div>
                                    <p class="text-[10px] font-bold text-luxury-400 uppercase tracking-tight">Check-in</p>
                                    <p class="text-sm font-bold text-luxury-900 truncate">
                                        <%= listing.operating_hours || '2:00 PM' %>
                                    </p>
                                </div>
                            </div>
                        </div>

                        <!-- Description Section -->
                        <article class="prose prose-stone max-w-none mb-12 relative">
                            <div class="absolute inset-0 bg-white rounded-3xl shadow-sm"></div>
                            <div class="relative bg-white rounded-3xl p-8 border border-luxury-100 luxury-shadow">
                                <div class="flex items-center gap-4 mb-6">
                                    <h2 class="text-3xl font-serif font-bold text-luxury-900 tracking-tight">Welcome to <%= listing.title %>
                                    </h2>
                                    <div class="h-px flex-1 bg-luxury-200"></div>
                                </div>
                                <p id="description"
                                    class="text-lg text-luxury-600 leading-relaxed first-letter:text-5xl first-letter:font-serif first-letter:font-bold first-letter:text-luxury-700 first-letter:mr-3 first-letter:float-left">
                                    <%= listing.description %>
                                </p>
                            </div>
                        </article>

                        <!-- Amenities -->
                        <% if (listing.activity_tags && listing.activity_tags.length) { %>
                            <section class="mb-12">
                                <h3 class="text-lg font-bold text-luxury-900 mb-6 flex items-center gap-2 font-serif tracking-tight">
                                    <svg class="w-5 h-5 text-gold-500" fill="none" stroke="currentColor"
                                        viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                            d="M5 3v4M3 5h4M6 17v4m-2-2h4m5-16l2.286 6.857L21 12l-5.714 2.143L13 21l-2.286-6.857L5 12l5.714-2.143L13 3z">
                                        </path>
                                    </svg>
                                    Amenities & Services
                                </h3>
                                <div class="flex flex-wrap gap-3">
                                    <% listing.activity_tags.forEach(function(tag) { %>
                                        <a href="/hotels?tag=<%= encodeURIComponent(tag) %>"
                                            class="px-5 py-2.5 bg-white border border-luxury-200 text-luxury-700 rounded-2xl text-sm font-semibold hover:border-luxury-600 hover:text-luxury-900 hover:shadow-lg hover:shadow-luxury-900/5 transition-all">
                                            <%= tag %>
                                        </a>
                                        <% }); %>
                                </div>
                            </section>
                            <% } %>

                                <!-- Map -->
                                <section class="mb-12">
                                    <div class="flex items-center justify-between mb-6">
                                        <h3 class="text-lg font-bold text-luxury-900 font-serif tracking-tight">Location</h3>
                                        <a href="https://www.google.com/maps/dir/?api=1&destination= <%= listing.geo_lat %>,<%= listing.geo_lng %>"
                                            target="_blank" class="text-sm font-bold text-luxury-700 hover:text-luxury-900 hover:underline flex items-center gap-1 transition-colors">
                                            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 20l-5.447-2.724A1 1 0 013 16.382V5.618a1 1 0 011.447-.894L9 7m0 13l6-3m-6 3V7m6 10l4.553 2.276A1 1 0 0121 18.382V7.618a1 1 0 01-.553-.894L15 7m0 13V7m0 0L9.553 4.553A1 1 0 009 4.118v.002"></path>
                                            </svg>
                                            Get Directions
                                        </a>
                                    </div>
                                    <div
                                        class="rounded-[2rem] overflow-hidden shadow-inner bg-luxury-100 ring-8 ring-white">
                                        <iframe
                                            src="https://maps.google.com/maps?q= <%= listing.geo_lat %>,<%= listing.geo_lng %>&z=15&output=embed"
                                            width="100%" height="400" style="border:0;" allowfullscreen="true"
                                            loading="lazy" class="grayscale-[0.1] contrast-[1.05]"></iframe>
                                    </div>
                                </section>
                    </div>

                    <!-- Right Column: Sidebar -->
                    <div class="lg:col-span-4 space-y-8">
                        <aside class="sticky top-24">
                            <div
                                class="bg-white rounded-[2.5rem] border border-luxury-100 luxury-shadow p-8 relative overflow-hidden">
                                <div class="absolute top-0 right-0 w-40 h-40 bg-gradient-to-bl from-gold-400/10 to-transparent rounded-full -mr-20 -mt-20"></div>
                                
                                <h3 class="text-xl font-serif font-bold text-luxury-900 mb-6 relative tracking-tight">Book Your Stay</h3>

                                <div class="space-y-6 relative">
                                    <% if (listing.contact_info && listing.contact_info.phone) { %>
                                        <div class="flex items-start gap-4 group cursor-pointer">
                                            <div
                                                class="w-10 h-10 rounded-xl bg-luxury-50 flex items-center justify-center shrink-0 group-hover:bg-luxury-100 transition-colors">
                                                <svg class="w-5 h-5 text-luxury-600" fill="none" stroke="currentColor"
                                                    viewBox="0 0 24 24">
                                                    <path stroke-linecap="round" stroke-linejoin="round"
                                                        stroke-width="2"
                                                        d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z">
                                                    </path>
                                                </svg>
                                            </div>
                                            <div>
                                                <p class="text-xs font-bold text-luxury-400 uppercase">Reservations</p>
                                                <p class="text-sm font-semibold text-luxury-900 group-hover:text-luxury-700 transition-colors">
