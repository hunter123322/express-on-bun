                <nav class="hidden lg:flex items-center gap-2 text-sm text-stone-500 mb-8">
                    <a href="/" class="hover:text-brand-600 transition-colors">Home</a>
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
                    </svg>
                    <a href="/restaurants" class="hover:text-brand-600 transition-colors">Restaurants</a>
