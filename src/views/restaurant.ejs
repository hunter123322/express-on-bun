                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
                    </svg>
                    <span class="text-stone-900 font-medium">
                        <%= listing.title %>
                    </span>
                </nav>

                <div class="grid grid-cols-1 lg:grid-cols-12 gap-12">
                    <!-- Left Column: Media & Core Info -->
                    <div class="lg:col-span-8">
                        <!-- Hero Image Gallery Style -->
                        <section
                            class="relative rounded-[2.5rem] overflow-hidden bg-stone-200 w-full max-h-[75vh] shadow-2xl shadow-brand-900/10 mb-10 group">
                            
                            <img 
                                src="<%= listing.cover_image %>" 
                                alt="<%= listing.title %>"
                                class="w-full h-auto max-h-[75vh] object-contain md:object-cover transform group-hover:scale-105 transition-transform duration-700">
                            
                            <div
                                class="absolute inset-0 bg-gradient-to-t from-black/80 via-black/20 to-transparent flex items-end">
                                <div class="p-8 md:p-12 w-full">
                                    <div class="flex flex-wrap items-center gap-3 mb-4">
                                        <span
                                            class="px-4 py-1.5 rounded-full bg-brand-600 text-white text-xs font-bold uppercase tracking-wider shadow-lg">
                                            <%= listing.category || 'Restaurant' %>
                                        </span>
                                        <% if (listing.is_premium) { %>
                                            <span
                                                class="px-4 py-1.5 rounded-full bg-amber-400 text-stone-900 text-xs font-bold uppercase tracking-wider shadow-lg">
                                                Chef's Pick
                                            </span>
                                        <% } %>
                                    </div>
                                    <h1 class="text-4xl md:text-6xl font-serif font-black text-white leading-tight italic">
                                        <%= listing.title %>
                                    </h1>
                                    <p class="text-stone-300 mt-2 text-lg font-light">
                                        <%= listing.municipality %>, Albay
                                    </p>
                                </div>
                            </div>
                        </section>

                        <!-- Quick Stats Row -->
                        <div class="grid grid-cols-2 md:grid-cols-4 gap-4 mb-12">
                            <div
                                class="bg-white p-5 rounded-3xl border border-stone-100 shadow-sm flex items-center gap-4 hover:shadow-md transition-shadow">
                                <div class="w-10 h-10 rounded-2xl bg-brand-50 flex items-center justify-center">
                                    <svg class="w-5 h-5 text-brand-600" fill="none" stroke="currentColor"
                                        viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                            d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z">
                                        </path>
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                            d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path>
                                    </svg>
                                </div>
                                <div>
                                    <p class="text-[10px] font-bold text-stone-400 uppercase tracking-tight">Location
                                    </p>
                                    <p class="text-sm font-bold text-stone-900">
                                        <%= listing.municipality %>
                                    </p>
                                </div>
                            </div>
                            <div
                                class="bg-white p-5 rounded-3xl border border-stone-100 shadow-sm flex items-center gap-4 hover:shadow-md transition-shadow">
                                <div class="w-10 h-10 rounded-2xl bg-amber-50 flex items-center justify-center">
                                    <svg class="w-5 h-5 text-amber-500 fill-amber-500" fill="currentColor"
                                        viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                            d="M11.049 2.927c.3-.921 1.603-.921 1.902 0l1.519 4.674a1 1 0 00.95.69h4.915c.969 0 1.371 1.24.588 1.81l-3.976 2.888a1 1 0 00-.363 1.118l1.518 4.674c.3.922-.755 1.688-1.538 1.118l-3.976-2.888a1 1 0 00-1.176 0l-3.976 2.888c-.783.57-1.838-.197-1.538-1.118l1.518-4.674a1 1 0 00-.363-1.118l-3.976-2.888c-.784-.57-.38-1.81.588-1.81h4.914a1 1 0 00.951-.69l1.519-4.674z">
                                        </path>
                                    </svg>
                                </div>
                                <div>
                                    <p class="text-[10px] font-bold text-stone-400 uppercase tracking-tight">Rating</p>
                                    <p class="text-sm font-bold text-stone-900">
                                        <%= listing.rating ? listing.rating.toFixed(1) : 'N/A' %>
                                    </p>
                                </div>
                            </div>
                            <div
                                class="bg-white p-5 rounded-3xl border border-stone-100 shadow-sm flex items-center gap-4 hover:shadow-md transition-shadow">
                                <div class="w-10 h-10 rounded-2xl bg-emerald-50 flex items-center justify-center">
                                    <svg class="w-5 h-5 text-emerald-600" fill="none" stroke="currentColor"
                                        viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                            d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z">
                                        </path>
                                    </svg>
                                </div>
                                <div>
                                    <p class="text-[10px] font-bold text-stone-400 uppercase tracking-tight">Price Range
                                    </p>
                                    <p class="text-sm font-bold text-stone-900">
                                        <%= listing.pricing_lowest ? '₱' + listing.pricing_lowest : '₱' %>
                                    </p>
                                </div>
                            </div>
                            <div
                                class="bg-white p-5 rounded-3xl border border-stone-100 shadow-sm flex items-center gap-4 hover:shadow-md transition-shadow">
                                <div class="w-10 h-10 rounded-2xl bg-rose-50 flex items-center justify-center">
                                    <svg class="w-5 h-5 text-rose-600" fill="none" stroke="currentColor"
                                        viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                            d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                                    </svg>
                                </div>
                                <div>
                                    <p class="text-[10px] font-bold text-stone-400 uppercase tracking-tight">Hours</p>
                                    <p class="text-sm font-bold text-stone-900 truncate">
                                        <%= listing.operating_hours || 'Open Now' %>
                                    </p>
                                </div>
                            </div>
                        </div>

                        <!-- Description Section -->
                        <article class="max-w-none mb-14 relative">
                            <div class="relative bg-amber-50/80 backdrop-blur-sm rounded-3xl p-8 border border-amber-200 shadow-lg">

                                <!-- Header -->
                                <div class="flex items-center gap-4 mb-8">
                                <h2 class="text-3xl md:text-4xl font-serif font-bold text-amber-900 tracking-wide">
                                    About <%= listing.title %>
                                </h2>
                                <div class="h-px flex-1 bg-amber-300"></div>
                                </div>

                                <!-- Description -->
                                <p id="description"
                                class="text-lg md:text-xl text-amber-800 leading-relaxed first-letter:text-6xl first-letter:font-serif first-letter:font-bold first-letter:text-red-700 first-letter:mr-4 first-letter:float-left">
                                <%= listing.description %>
                                </p>

                                <!-- Decorative Accent -->
                                <div class="absolute -top-6 -right-6 w-24 h-24 bg-red-100 rounded-full blur-2xl opacity-40"></div>
                                <div class="absolute -bottom-6 -left-6 w-32 h-32 bg-amber-200 rounded-full blur-3xl opacity-30"></div>

                            </div>
                        </article>

                        <!-- Cuisine/Tags -->
                        <% if (listing.activity_tags && listing.activity_tags.length) { %>
                            <section class="mb-12">
                                <h3 class="text-lg font-bold text-stone-900 mb-6 flex items-center gap-2 font-serif italic">
                                    <svg class="w-5 h-5 text-brand-600" fill="none" stroke="currentColor"
                                        viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                            d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253">
                                        </path>
                                    </svg>
                                    Menu Highlights
                                </h3>
                                <div class="flex flex-wrap gap-3">
                                    <% listing.activity_tags.forEach(function(tag) { %>
                                        <a href="/restaurants?tag=<%= encodeURIComponent(tag) %>"
                                            class="px-5 py-2.5 bg-white border border-stone-200 text-stone-700 rounded-2xl text-sm font-semibold hover:border-brand-600 hover:text-brand-600 hover:shadow-lg hover:shadow-brand-900/5 transition-all">
                                            <%= tag %>
                                        </a>
                                        <% }); %>
                                </div>
                            </section>
                            <% } %>

                                <!-- Map -->
                                <section class="mb-12">
                                    <div class="flex items-center justify-between mb-6">
                                        <h3 class="text-lg font-bold text-stone-900 font-serif italic">Find Us</h3>
                                        <a href="https://www.google.com/maps/dir/?api=1&destination= <%= listing.geo_lat %>,<%= listing.geo_lng %>"
                                            target="_blank" class="text-sm font-bold text-brand-600 hover:underline flex items-center gap-1">
                                            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 20l-5.447-2.724A1 1 0 013 16.382V5.618a1 1 0 011.447-.894L9 7m0 13l6-3m-6 3V7m6 10l4.553 2.276A1 1 0 0121 18.382V7.618a1 1 0 01-.553-.894L15 7m0 13V7m0 0L9.553 4.553A1 1 0 009 4.118v.002"></path>
                                            </svg>
                                            Get Directions
                                        </a>
                                    </div>
                                    <div
                                        class="rounded-[2rem] overflow-hidden shadow-inner bg-stone-100 ring-8 ring-white">
                                        <iframe
                                            src="https://maps.google.com/maps?q= <%= listing.geo_lat %>,<%= listing.geo_lng %>&z=15&output=embed"
                                            width="100%" height="400" style="border:0;" allowfullscreen="true"
                                            loading="lazy" class="grayscale-[0.2] contrast-[1.1]"></iframe>
                                    </div>
                                </section>
                    </div>

                    <!-- Right Column: Sidebar -->
                    <div class="lg:col-span-4 space-y-8">
                        <aside class="sticky top-20 mb-12">
                            <div
                                class="bg-amber-50/20 backdrop-blur-sm rounded-3xl p-8 border border-amber-200 shadow-lg">
                                <div class="absolute top-0 right-0 w-32 h-32 bg-brand-50 rounded-full -mr-16 -mt-16 opacity-50"></div>
                                
                                <h3 class="text-xl font-serif font-bold text-stone-900 mb-6 relative">Reservations & Contact</h3>

                                <div class="space-y-6 relative">
                                    <% if (listing.contact_info && listing.contact_info.phone) { %>
                                        <div class="flex items-start gap-4 group cursor-pointer">
                                            <div
                                                class="w-10 h-10 rounded-xl bg-brand-50 flex items-center justify-center shrink-0 group-hover:bg-brand-100 transition-colors">
                                                <svg class="w-5 h-5 text-brand-600" fill="none" stroke="currentColor"
                                                    viewBox="0 0 24 24">
                                                    <path stroke-linecap="round" stroke-linejoin="round"
                                                        stroke-width="2"
                                                        d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z">
                                                    </path>
                                                </svg>
                                            </div>
                                            <div>
                                                <p class="text-xs font-bold text-stone-400 uppercase">Phone</p>
                                                <p class="text-sm font-semibold text-stone-900 group-hover:text-brand-600 transition-colors">
                                                    <%= listing.contact_info.phone %>
                                                </p>
                                            </div>
                                        </div>
                                        <% } %>

                                            <% if (listing.contact_info && listing.contact_info.email) { %>
                                                <div class="flex items-start gap-4 group cursor-pointer">
                                                    <div
                                                        class="w-10 h-10 rounded-xl bg-brand-50 flex items-center justify-center shrink-0 group-hover:bg-brand-100 transition-colors">
                                                        <svg class="w-5 h-5 text-brand-600" fill="none"
                                                            stroke="currentColor" viewBox="0 0 24 24">
                                                            <path stroke-linecap="round" stroke-linejoin="round"
                                                                stroke-width="2"
                                                                d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z">
                                                            </path>
                                                        </svg>
                                                    </div>
                                                    <div>
                                                        <p class="text-xs font-bold text-stone-400 uppercase">Email</p>
                                                        <p class="text-sm font-semibold text-stone-900 group-hover:text-brand-600 transition-colors">
                                                            <%= listing.contact_info.email %>
                                                        </p>
                                                    </div>
                                                </div>
                                                <% } %>

                                                    <div class="pt-6 border-t border-stone-50 space-y-4">
                                                        <button
                                                            class="w-full bg-brand-600 hover:bg-brand-700 text-white font-bold py-4 rounded-2xl shadow-lg shadow-brand-200 transition-all flex items-center justify-center gap-2 group">
                                                            <svg class="w-5 h-5 group-hover:rotate-12 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"></path>
                                                            </svg>
                                                            Book a Table
                                                        </button>
                                                        <button
                                                            class="w-full bg-white hover:bg-stone-200 text-stone-900 font-bold py-4 rounded-2xl transition-all flex items-center justify-center gap-2">
                                                            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"></path>
                                                            </svg>
                                                            View Menu
                                                        </button>
                                                    </div>
                                </div>

                                <!-- Social Links -->
                                <div class="flex items-center justify-center gap-4 mt-8 relative">
                                    <% if (listing.social_links && listing.social_links.facebook) { %>
                                        <a href="<%= listing.social_links.facebook %>"
                                            class="w-10 h-10 rounded-full bg-stone-100 flex items-center justify-center text-stone-600 hover:bg-brand-50 hover:text-brand-600 transition-all hover:scale-110">
                                            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
                                                <path
