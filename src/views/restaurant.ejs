<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>

    <% if (listing) { const pageUrl=`https://yourdomain.com/restaurants/ ${listing.slug}`; const imageUrl=listing.cover_image; const description=listing.description?.substring(0, 160) || '' ; %>

        <title>
            <%= listing.title %> | Restaurant in <%= listing.municipality %>
        </title>

        <meta name="description" content="<%= description %>">
        <meta name="keywords"
            content="<%= listing.title %>, <%= listing.municipality %> restaurant, Albay dining, food in <%= listing.municipality %>, best restaurants Albay">
        <meta name="author" content="Your Website Name">
        <meta name="robots" content="index, follow">
        <link rel="canonical" href="<%= pageUrl %>">

        <meta property="og:type" content="restaurant">
        <meta property="og:title" content="<%= listing.title %>">
        <meta property="og:description" content="<%= description %>">
        <meta property="og:url" content="<%= pageUrl %>">
        <meta property="og:image" content="<%= imageUrl %>">
        <meta property="og:site_name" content="Your Website Name">

        <meta name="twitter:card" content="summary_large_image">
        <meta name="twitter:title" content="<%= listing.title %>">
        <meta name="twitter:description" content="<%= description %>">
        <meta name="twitter:image" content="<%= imageUrl %>">

        <script src="https://cdn.tailwindcss.com "></script>
        <script>
            tailwind.config = {
                theme: {
                    extend: {
                        colors: {
                            brand: {
                                50: '#fff7ed',
                                100: '#ffedd5',
                                200: '#fed7aa',
                                300: '#fdba74',
                                400: '#fb923c',
                                500: '#f97316',
                                600: '#ea580c',
                                700: '#c2410c',
                                800: '#9a3412',
                                900: '#7c2d12',
                            }
                        }
                    }
                }
            }
        </script>
        <script>
            document.addEventListener("DOMContentLoaded", function () {
                const el = document.getElementById('description');
                if (!el) return;

                let text = el.innerHTML || '';

                text = text.replace(/&lt;br\s*\/?&gt;/gi, '<br>');
                text = text.replace(/\r\n/g, '\n');
                text = text.replace(/\n\n+/g, '</p><p class="mt-4">');
                text = text.replace(/\n/g, '<br>');
                text = `<p>${text}</p>`;

                el.innerHTML = text;
            });
        </script>
        <script type="application/ld+json">
        {
        "@context": "https://schema.org ",
        "@type": "Restaurant",
        "name": "<%= listing.title %>",
        "description": "<%= description.replace(/"/g, '\\"') %>",
        "image": "<%= imageUrl %>",
        "url": "<%= pageUrl %>",
        "address": {
            "@type": "PostalAddress",
            "addressLocality": "<%= listing.municipality %>",
            "addressRegion": "Albay",
            "addressCountry": "PH"
        },
        "geo": {
            "@type": "GeoCoordinates",
            "latitude": <%= listing.geo_lat || 0 %>,
            "longitude": <%= listing.geo_lng || 0 %>
        },
        "servesCuisine": "<%= listing.category || 'Local Cuisine' %>",
        "priceRange": "<%= listing.pricing_lowest ? '₱₱' : '₱' %>"<% if (listing.rating) { %>,
        "aggregateRating": {
            "@type": "AggregateRating",
            "ratingValue": "<%= listing.rating.toFixed(1) %>",
            "bestRating": "5",
            "worstRating": "1",
            "ratingCount": "1"
        }<% } %><% if (listing.contact_info && listing.contact_info.phone) { %>,
        "telephone": "<%= listing.contact_info.phone %>"<% } %>
        }   
    </script>

        <% } %>

            <style scoped>
                @import url('https://fonts.googleapis.com/css2?family=Playfair+Display:wght@400;600;700&family=Inter:wght@300;400;500;600;700&display=swap');

                .font-serif {
                    font-family: 'Playfair Display', serif;
                }

                .font-sans {
                    font-family: 'Inter', sans-serif;
                }

                .nav-link {
                    color: inherit;
                    transition: color 0.2s;
                }

                .nav-link:hover {
                    color: #ea580c;
                }

                .mobile-link {
                    display: flex;
                    align-items: center;
                    gap: 0.75rem;
                    transition: color 0.2s;
                }

                .mobile-link:hover {
                    color: #ea580c;
                }

                .footer-title {
                    color: #ffffff;
                    font-weight: 600;
                    margin-bottom: 1rem;
                }

                .footer-list li {
                    color: #94a3b8;
                    font-size: 0.875rem;
                    transition: color 0.2s;
                }

                .footer-list li:hover {
                    color: #ffffff;
                }

                .social-icon {
                    width: 2.25rem;
                    height: 2.25rem;
                    border-radius: 9999px;
                    background-color: #1e293b;
                    display: flex;
                    align-items: center;
                    justify-content: center;
                    font-size: 0.75rem;
                    font-weight: 600;
                    cursor: pointer;
                    transition: background-color 0.2s;
                }

                .social-icon:hover {
                    background-color: #ea580c;
                }

                /* Animations */
                .fade-enter-active,
                .fade-leave-active {
                    transition: opacity 0.2s ease;
                }

                .fade-enter-from,
                .fade-leave-to {
                    opacity: 0;
                }

                .slide-enter-active,
                .slide-leave-active {
                    transition: transform 0.25s ease;
                }

                .slide-enter-from,
                .slide-leave-to {
                    transform: translateX(100%);
                }

                .glass-card {
                    background: rgba(255, 255, 255, 0.9);
                    backdrop-filter: blur(20px);
                    border: 1px solid rgba(255, 255, 255, 0.2);
                }

                .menu-pattern {
                    background-image: radial-gradient(#ea580c 0.5px, transparent 0.5px);
                    background-size: 20px 20px;
                    opacity: 0.03;
                }
            </style>
</head>

<body class="font-sans bg-stone-50">
    <% if (listing) { %>
        <div class="bg-stone-50 min-h-screen">
            <!-- Navigation Overlay -->
            <div
                class="fixed top-0 left-0 right-0 z-50 bg-white/90 backdrop-blur-md border-b border-stone-100 lg:hidden">
                <div class="px-4 py-3 flex items-center justify-between">
                    <a href="/restaurants" class="p-2 hover:bg-stone-100 rounded-full transition-colors">
                        <svg class="w-5 h-5 text-stone-700" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                d="M10 19l-7-7m0 0l7-7m-7 7h18"></path>
                        </svg>
                    </a>
                    <h2 class="text-sm font-bold text-stone-900 truncate max-w-[200px]">
                        <%= listing.title %>
                    </h2>
                    <button class="p-2 hover:bg-stone-100 rounded-full transition-colors">
                        <svg class="w-5 h-5 text-stone-700" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z">
                            </path>
                        </svg>
                    </button>
                </div>
            </div>

            <!-- Main Content Area -->
            <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pt-20 lg:pt-12">
