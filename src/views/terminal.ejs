<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>

    <% if (terminal) { const pageUrl=`https://yourdomain.com/terminals/${terminal.slug}`; const imageUrl=terminal.cover_image; const description=terminal.description?.substring(0, 160) || ''; %>

        <title>
            <%= terminal.name %> | Transport Terminal in <%= terminal.municipality %>
        </title>

        <meta name="description" content="<%= description %>">
        <meta name="keywords"
            content="<%= terminal.name %>, <%= terminal.municipality %> terminal, Albay transport, bus terminal <%= terminal.municipality %>, van terminal">
        <meta name="author" content="Your Website Name">
        <meta name="robots" content="index, follow">
        <link rel="canonical" href="<%= pageUrl %>">

        <meta property="og:type" content="place">
        <meta property="og:title" content="<%= terminal.name %>">
        <meta property="og:description" content="<%= description %>">
        <meta property="og:url" content="<%= pageUrl %>">
        <meta property="og:image" content="<%= imageUrl %>">
        <meta property="og:site_name" content="Your Website Name">

        <meta name="twitter:card" content="summary_large_image">
        <meta name="twitter:title" content="<%= terminal.name %>">
        <meta name="twitter:description" content="<%= description %>">
        <meta name="twitter:image" content="<%= imageUrl %>">

        <script src="https://cdn.tailwindcss.com"></script>
        <script>
            document.addEventListener("DOMContentLoaded", function () {
                const el = document.getElementById('description');
                if (!el) return;

                let text = el.innerHTML || '';

                text = text.replace(/&lt;br\s*\/?&gt;/gi, '<br>');
                text = text.replace(/\r\n/g, '\n');
                text = text.replace(/\n\n+/g, '</p><p class="mt-4">');
                text = text.replace(/\n/g, '<br>');
                text = `<p>${text}</p>`;

                el.innerHTML = text;
            });
        </script>
        <script type="application/ld+json">
        {
        "@context": "https://schema.org",
        "@type": "BusStation",
        "name": "<%= terminal.name %>",
        "description": "<%= description.replace(/"/g, '\\"') %>",
        "image": "<%= imageUrl %>",
        "url": "<%= pageUrl %>",
        "address": {
            "@type": "PostalAddress",
            "addressLocality": "<%= terminal.municipality %>",
            "addressRegion": "Albay",
            "addressCountry": "PH"
        },
        "geo": {
            "@type": "GeoCoordinates",
            "latitude": <%= terminal.geo_lat || 0 %>,
            "longitude": <%= terminal.geo_lng || 0 %>
        }<% if (terminal.rating) { %>,
        "aggregateRating": {
            "@type": "AggregateRating",
            "ratingValue": "<%= terminal.rating.toFixed(1) %>",
            "bestRating": "5",
            "worstRating": "1",
            "ratingCount": "1"
        }<% } %>
        }   
    </script>

        <% } %>

            <style scoped>
                .nav-link {
                    color: inherit;
                    transition: color 0.2s;
                }

                .nav-link:hover {
                    color: #2563eb;
                }

                .mobile-link {
                    display: flex;
                    align-items: center;
                    gap: 0.75rem;
                    transition: color 0.2s;
                }

                .mobile-link:hover {
                    color: #2563eb;
                }

                .footer-title {
                    color: #ffffff;
                    font-weight: 600;
                    margin-bottom: 1rem;
                }

                .footer-list li {
                    color: #94a3b8;
                    font-size: 0.875rem;
                    transition: color 0.2s;
                }

                .footer-list li:hover {
                    color: #ffffff;
                }

                .social-icon {
                    width: 2.25rem;
                    height: 2.25rem;
                    border-radius: 9999px;
                    background-color: #1e293b;
                    display: flex;
                    align-items: center;
                    justify-content: center;
                    font-size: 0.75rem;
                    font-weight: 600;
                    cursor: pointer;
                    transition: background-color 0.2s;
                }

                .social-icon:hover {
                    background-color: #2563eb;
                }

                .fade-enter-active,
                .fade-leave-active {
                    transition: opacity 0.2s ease;
                }

                .fade-enter-from,
                .fade-leave-to {
                    opacity: 0;
                }

                .slide-enter-active,
                .slide-leave-active {
                    transition: transform 0.25s ease;
                }

                .slide-enter-from,
                .slide-leave-to {
                    transform: translateX(100%);
                }
            </style>
</head>

<body>
    <% if (terminal) { %>
        <div class="bg-gray-50">
            <!-- Navigation Overlay -->
            <div
                class="relative top-0 left-0 right-0 z-50 bg-white/80 backdrop-blur-md border-b border-gray-100 lg:hidden">
                <div class="px-4 py-3 flex items-center justify-between">
                    <a href="/terminals" class="p-2 hover:bg-gray-100 rounded-full transition-colors">
                        <svg class="w-5 h-5 text-slate-700" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                d="M10 19l-7-7m0 0l7-7m-7 7h18"></path>
                        </svg>
                    </a>
                    <h2 class="text-sm font-bold text-slate-900 truncate max-w-[200px]">
                        <%= terminal.name %>
                    </h2>
                    <button class="p-2 hover:bg-gray-100 rounded-full transition-colors">
                        <svg class="w-5 h-5 text-slate-700" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                d="M8.684 13.342C8.886 12.938 9 12.482 9 12c0-.482-.114-.938-.316-1.342m0 2.684a3 3 0 110-2.684m0 2.684l6.632 3.316m-6.632-6l6.632-3.316m0 0a3 3 0 105.367-2.684 3 3 0 00-5.367 2.684zm0 9.316a3 3 0 105.368 2.684 3 3 0 00-5.368-2.684z">
                            </path>
                        </svg>
                    </button>
                </div>
            </div>

            <!-- Main Content Area -->
            <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pt-5">
                <!-- Breadcrumbs -->
                <nav class="hidden lg:flex items-center gap-2 text-sm text-slate-400 mb-8">
                    <a href="/" class="hover:text-blue-600 transition-colors">Home</a>
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
                    </svg>
                    <a href="/terminals" class="hover:text-blue-600 transition-colors">Terminals</a>
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
                    </svg>
                    <span class="text-slate-900 font-medium">
                        <%= terminal.name %>
                    </span>
                </nav>

                <div class="grid grid-cols-1 lg:grid-cols-12 gap-12">
                    <!-- Left Column: Media & Core Info -->
                    <div class="lg:col-span-8">
                        <!-- Hero Image Gallery Style -->
                        <section
                            class="relative rounded-[2.5rem] overflow-hidden bg-slate-200 w-full max-h-[75vh] shadow-2xl shadow-blue-900/10 mb-10">
                            
                            <img 
                                src="<%= terminal.cover_image %>" 
                                alt="<%= terminal.name %>"
                                class="w-full h-auto max-h-[75vh] object-contain md:object-cover transform hover:scale-105 transition-transform duration-700">
                            
                            <div
                                class="absolute inset-0 bg-gradient-to-t from-black/80 via-black/20 to-transparent flex items-end">
                                <div class="p-8 md:p-12 w-full">
                                    <div class="flex flex-wrap items-center gap-3 mb-4">
                                        <span
                                            class="px-3 py-1 rounded-full bg-blue-600 text-white text-xs font-bold uppercase tracking-wider">
                                            <%= terminal.terminal_type || 'Terminal' %>
                                        </span>
                                        <% if (terminal.is_24_hours) { %>
                                            <span
                                                class="px-3 py-1 rounded-full bg-emerald-400 text-slate-900 text-xs font-bold uppercase tracking-wider">
                                                Open 24/7
                                            </span>
                                        <% } %>
                                    </div>
                                    <h1 class="text-3xl md:text-5xl font-black text-white leading-tight">
                                        <%= terminal.name %>
                                    </h1>
                                </div>
                            </div>
                        </section>

                        <!-- Quick Stats Row -->
                        <div class="grid grid-cols-2 md:grid-cols-4 gap-4 mb-12">
                            <div
                                class="bg-white p-5 rounded-3xl border border-slate-100 shadow-sm flex items-center gap-4">
                                <div class="w-10 h-10 rounded-2xl bg-blue-50 flex items-center justify-center">
                                    <svg class="w-5 h-5 text-blue-600" fill="none" stroke="currentColor"
                                        viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                            d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z">
                                        </path>
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                            d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path>
                                    </svg>
                                </div>
                                <div>
                                    <p class="text-[10px] font-bold text-slate-400 uppercase tracking-tight">Location
                                    </p>
                                    <p class="text-sm font-bold text-slate-900">
                                        <%= terminal.municipality %>
                                    </p>
                                </div>
                            </div>
                            <div
                                class="bg-white p-5 rounded-3xl border border-slate-100 shadow-sm flex items-center gap-4">
                                <div class="w-10 h-10 rounded-2xl bg-amber-50 flex items-center justify-center">
                                    <svg class="w-5 h-5 text-amber-500 fill-amber-500" fill="currentColor"
                                        viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                            d="M11.049 2.927c.3-.921 1.603-.921 1.902 0l1.519 4.674a1 1 0 00.95.69h4.915c.969 0 1.371 1.24.588 1.81l-3.976 2.888a1 1 0 00-.363 1.118l1.518 4.674c.3.922-.755 1.688-1.538 1.118l-3.976-2.888a1 1 0 00-1.176 0l-3.976 2.888c-.783.57-1.838-.197-1.538-1.118l1.518-4.674a1 1 0 00-.363-1.118l-3.976-2.888c-.784-.57-.38-1.81.588-1.81h4.914a1 1 0 00.951-.69l1.519-4.674z">
                                        </path>
                                    </svg>
                                </div>
                                <div>
                                    <p class="text-[10px] font-bold text-slate-400 uppercase tracking-tight">Rating</p>
                                    <p class="text-sm font-bold text-slate-900">
                                        <%= terminal.rating ? terminal.rating.toFixed(1) : 'N/A' %>
                                    </p>
                                </div>
                            </div>
                            <div
                                class="bg-white p-5 rounded-3xl border border-slate-100 shadow-sm flex items-center gap-4">
                                <div class="w-10 h-10 rounded-2xl bg-emerald-50 flex items-center justify-center">
                                    <svg class="w-5 h-5 text-emerald-600" fill="none" stroke="currentColor"
                                        viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                            d="M8 7h12m0 0l-4-4m4 4l-4 4m0 6H4m0 0l4 4m-4-4l4-4">
                                        </path>
                                    </svg>
                                </div>
                                <div>
                                    <p class="text-[10px] font-bold text-slate-400 uppercase tracking-tight">Routes
                                    </p>
                                    <p class="text-sm font-bold text-slate-900">
                                        <%= terminal.routes_count || 'Multiple' %>
                                    </p>
                                </div>
                            </div>
                            <div
                                class="bg-white p-5 rounded-3xl border border-slate-100 shadow-sm flex items-center gap-4">
                                <div class="w-10 h-10 rounded-2xl bg-purple-50 flex items-center justify-center">
                                    <svg class="w-5 h-5 text-purple-600" fill="none" stroke="currentColor"
                                        viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                            d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                                    </svg>
                                </div>
                                <div>
                                    <p class="text-[10px] font-bold text-slate-400 uppercase tracking-tight">Hours</p>
                                    <p class="text-sm font-bold text-slate-900 truncate">
                                        <%= terminal.operating_hours || '24 Hours' %>
                                    </p>
                                </div>
                            </div>
                        </div>

                        <!-- Description Section -->
                        <article class="prose prose-slate max-w-none mb-12">
                            <div class="flex items-center gap-4 mb-6">
                                <h2 class="text-2xl font-extrabold text-slate-900">About <%= terminal.name %>
                                </h2>
                                <div class="h-px flex-1 bg-slate-100"></div>
                            </div>
                            <p id="description"
                                class="text-lg text-slate-600 leading-relaxed first-letter:text-5xl first-letter:font-black first-letter:text-blue-600 first-letter:mr-3 first-letter:float-left">
                                <%= terminal.description %>
                            </p>
                        </article>

                        <!-- Available Routes -->
                        <% if (terminal.routes && terminal.routes.length) { %>
                            <section class="mb-12">
                                <h3 class="text-lg font-bold text-slate-900 mb-6 flex items-center gap-2">
                                    <svg class="w-5 h-5 text-blue-600" fill="none" stroke="currentColor"
                                        viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                            d="M9 20l-5.447-2.724A1 1 0 013 16.382V5.618a1 1 0 011.447-.894L9 7m0 13l6-3m-6 3V7m6 10l4.553 2.276A1 1 0 0121 18.382V7.618a1 1 0 01-.553-.894L15 7m0 13V7">
                                        </path>
                                    </svg>
                                    Available Routes
                                </h3>
                                <div class="flex flex-wrap gap-3">
                                    <% terminal.routes.forEach(function(route) { %>
                                        <a href="/terminals?route=<%= encodeURIComponent(route) %>"
                                            class="px-5 py-2.5 bg-white border border-slate-200 text-slate-700 rounded-2xl text-sm font-semibold hover:border-blue-600 hover:text-blue-600 hover:shadow-lg hover:shadow-blue-900/5 transition-all">
                                            <%= route %>
                                        </a>
                                        <% }); %>
                                </div>
                            </section>
                            <% } %>

                                <!-- Facilities -->
                                <% if (terminal.facilities && terminal.facilities.length) { %>
                                    <section class="mb-12">
                                        <h3 class="text-lg font-bold text-slate-900 mb-6 flex items-center gap-2">
                                            <svg class="w-5 h-5 text-blue-600" fill="none" stroke="currentColor"
                                                viewBox="0 0 24 24">
                                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                                    d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4">
                                                </path>
                                            </svg>
                                            Facilities
                                        </h3>
                                        <div class="grid grid-cols-2 md:grid-cols-3 gap-4">
                                            <% terminal.facilities.forEach(function(facility) { %>
                                                <div
                                                    class="px-5 py-3 bg-slate-50 text-slate-700 rounded-2xl text-sm font-semibold flex items-center gap-2">
                                                    <svg class="w-4 h-4 text-emerald-500" fill="none" stroke="currentColor"
                                                        viewBox="0 0 24 24">
                                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                                            d="M5 13l4 4L19 7"></path>
                                                    </svg>
                                                    <%= facility %>
                                                </div>
                                                <% }); %>
                                        </div>
                                    </section>
                                    <% } %>

                                        <!-- Map -->
                                        <section class="mb-12">
                                            <div class="flex items-center justify-between mb-6">
                                                <h3 class="text-lg font-bold text-slate-900">Location Details</h3>
                                                <a href="https://www.google.com/maps/dir/?api=1&destination=<%= terminal.geo_lat %>,<%= terminal.geo_lng %>"
                                                    target="_blank" class="text-sm font-bold text-blue-600 hover:underline">
                                                    Get Directions
                                                </a>
                                            </div>
                                            <div
                                                class="rounded-[2rem] overflow-hidden shadow-inner bg-slate-100 ring-8 ring-white">
                                                <iframe
                                                    src="https://maps.google.com/maps?q=<%= terminal.geo_lat %>,<%= terminal.geo_lng %>&z=15&output=embed"
                                                    width="100%" height="400" style="border:0;" allowfullscreen="true"
                                                    loading="lazy" class="grayscale-[0.2] contrast-[1.1]"></iframe>
                                            </div>
                                        </section>
                    </div>

                    <!-- Right Column: Sidebar -->
                    <div class="lg:col-span-4 space-y-8">
                        <aside class="sticky top-24">
                            <div
                                class="bg-white rounded-[2rem] border border-slate-100 shadow-2xl shadow-slate-200/50 p-8">
                                <h3 class="text-xl font-bold text-slate-900 mb-6">Terminal Information</h3>

                                <div class="space-y-6">
                                    <% if (terminal.contact_info && terminal.contact_info.phone) { %>
                                        <div class="flex items-start gap-4">
                                            <div
                                                class="w-10 h-10 rounded-xl bg-slate-50 flex items-center justify-center shrink-0">
                                                <svg class="w-5 h-5 text-slate-600" fill="none" stroke="currentColor"
                                                    viewBox="0 0 24 24">
                                                    <path stroke-linecap="round" stroke-linejoin="round"
                                                        stroke-width="2"
                                                        d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z">
                                                    </path>
                                                </svg>
                                            </div>
                                            <div>
                                                <p class="text-xs font-bold text-slate-400 uppercase">Phone</p>
                                                <p class="text-sm font-semibold text-slate-900">
                                                    <%= terminal.contact_info.phone %>
                                                </p>
                                            </div>
                                        </div>
                                        <% } %>

                                            <% if (terminal.contact_info && terminal.contact_info.email) { %>
                                                <div class="flex items-start gap-4">
                                                    <div
                                                        class="w-10 h-10 rounded-xl bg-slate-50 flex items-center justify-center shrink-0">
                                                        <svg class="w-5 h-5 text-slate-600" fill="none"
                                                            stroke="currentColor" viewBox="0 0 24 24">
                                                            <path stroke-linecap="round" stroke-linejoin="round"
                                                                stroke-width="2"
                                                                d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z">
                                                            </path>
                                                        </svg>
                                                    </div>
                                                    <div>
                                                        <p class="text-xs font-bold text-slate-400 uppercase">Email</p>
                                                        <p class="text-sm font-semibold text-slate-900">
                                                            <%= terminal.contact_info.email %>
                                                        </p>
                                                    </div>
                                                </div>
                                                <% } %>

                                                    <div class="pt-6 border-t border-slate-50 space-y-4">
                                                        <button
                                                            class="w-full bg-blue-600 hover:bg-blue-700 text-white font-bold py-4 rounded-2xl shadow-lg shadow-blue-200 transition-all flex items-center justify-center gap-2">
                                                            View Schedule
                                                        </button>
                                                        <button
                                                            class="w-full bg-white hover:bg-slate-50 text-slate-900 border border-slate-200 font-bold py-4 rounded-2xl transition-all">
                                                            Contact Terminal
                                                        </button>
                                                    </div>
                                </div>

                                <!-- Transport Types -->
                                <div class="mt-8 pt-6 border-t border-slate-50">
                                    <p class="text-xs font-bold text-slate-400 uppercase mb-4">Transport Options</p>
                                    <div class="flex flex-wrap gap-2">
                                        <% if (terminal.transport_types && terminal.transport_types.length) { %>
                                            <% terminal.transport_types.forEach(function(type) { %>
                                                <span
                                                    class="px-3 py-1 bg-slate-100 text-slate-600 rounded-full text-xs font-semibold">
                                                    <%= type %>
                                                </span>
                                                <% }); %>
                                                    <% } else { %>
                                                        <span
                                                            class="px-3 py-1 bg-slate-100 text-slate-600 rounded-full text-xs font-semibold">Bus</span>
                                                        <span
                                                            class="px-3 py-1 bg-slate-100 text-slate-600 rounded-full text-xs font-semibold">Van</span>
                                                        <% } %>
                                    </div>
                                </div>
                            </div>

                            <div class="mt-8 rounded-3xl overflow-hidden shadow-sm">
                                <!-- AD Slot - Replace with actual ad code -->
                                <div class="bg-slate-100 p-4 text-center text-slate-400">Advertisement</div>
                            </div>
                        </aside>
                    </div>
                </div>
            </div>
        </div>
        <% } else { %>
            <div class="min-h-screen flex items-center justify-center bg-gray-50">
                <div class="text-center px-6">
                    <div class="w-24 h-24 bg-slate-200 rounded-full flex items-center justify-center mx-auto mb-6">
                        <svg class="w-10 h-10 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                d="M18.364 18.364A9 9 0 005.636 5.636m12.728 12.728A9 9 0 015.636 5.636m12.728 12.728L5.636 5.636">
                            </path>
                        </svg>
                    </div>
                    <h2 class="text-2xl font-bold text-slate-900">Terminal Not Found</h2>
                    <p class="text-slate-500 mt-2 mb-8">The terminal you're looking for might have been moved or removed.
                    </p>
                    <a href="/terminals"
                        class="px-8 py-3 bg-blue-600 text-white font-bold rounded-xl shadow-lg shadow-blue-200 inline-block">
                        Back to Directory
                    </a>
                </div>
            </div>
            <% } %>
                <footer class="bg-slate-900 text-slate-300">

                    <!-- Top Section -->
                    <div class="max-w-7xl mx-auto px-6 py-14 grid gap-12 md:grid-cols-4">

                        <!-- Brand -->
                        <div>
                            <h3 class="text-xl font-semibold text-white mb-4">
                                Discover <span class="text-blue-500">Albay</span>
                            </h3>
                            <p class="text-sm leading-relaxed text-slate-400">
                                Your trusted tourism directory platform to explore destinations,
                                restaurants, hotels, tour guides, and transport terminals across Albay.
                            </p>
                        </div>

                        <!-- Explore -->
                        <div>
                            <h4 class="footer-title">Explore</h4>
                            <ul class="footer-list">
                                <li>
                                    <a href="/tourist-spots">Tourist Spots</a>
                                </li>
                                <li>
                                    <a href="/restaurants">Restaurants</a>
                                </li>
                                <li>
                                    <a href="/hotels">Hotels</a>
                                </li>
                                <li>
                                    <a href="/tour-guides">Tour Guides</a>
                                </li>
                                <li>
                                    <a href="/terminals">Terminals</a>
                                </li>
                            </ul>
                        </div>

