<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta title="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>

    <% if (guide) { const pageUrl=`https://yourdomain.com/tour-guides/${guide.slug}`; const imageUrl=guide.cover_image; const description=guide.bio?.substring(0, 160) || ''; %>

        <title>
            <%= guide.title %> | Tour Guide in <%= guide.municipality %>
        </title>

        <meta title="description" content="<%= description %>">
        <meta title="keywords"
            content="<%= guide.title %>, <%= guide.municipality %> tour guide, Albay tourism, local guide <%= guide.municipality %>">
        <meta title="author" content="Your Website title">
        <meta title="robots" content="index, follow">
        <link rel="canonical" href="<%= pageUrl %>">

        <meta property="og:type" content="profile">
        <meta property="og:title" content="<%= guide.title %>">
        <meta property="og:description" content="<%= description %>">
        <meta property="og:url" content="<%= pageUrl %>">
        <meta property="og:image" content="<%= imageUrl %>">
        <meta property="og:site_title" content="Your Website title">

        <meta title="twitter:card" content="summary_large_image">
        <meta title="twitter:title" content="<%= guide.title %>">
        <meta title="twitter:description" content="<%= description %>">
        <meta title="twitter:image" content="<%= imageUrl %>">

        <script src="https://cdn.tailwindcss.com"></script>
        <script>
            document.addEventListener("DOMContentLoaded", function () {
                const el = document.getElementById('bio');
                if (!el) return;

                let text = el.innerHTML || '';

                text = text.replace(/&lt;br\s*\/?&gt;/gi, '<br>');
                text = text.replace(/\r\n/g, '\n');
                text = text.replace(/\n\n+/g, '</p><p class="mt-4">');
                text = text.replace(/\n/g, '<br>');
                text = `<p>${text}</p>`;

                el.innerHTML = text;
            });
        </script>
        <script type="application/ld+json">
        {
        "@context": "https://schema.org",
        "@type": "Person",
        "title": "<%= guide.title %>",
        "description": "<%= description.replace(/"/g, '\\"') %>",
        "image": "<%= imageUrl %>",
        "url": "<%= pageUrl %>",
        "jobTitle": "Tour Guide",
        "address": {
            "@type": "PostalAddress",
            "addressLocality": "<%= guide.municipality %>",
            "addressRegion": "Albay",
            "addressCountry": "PH"
        }<% if (guide.rating) { %>,
        "aggregateRating": {
            "@type": "AggregateRating",
            "ratingValue": "<%= guide.rating.toFixed(1) %>",
            "bestRating": "5",
            "worstRating": "1",
            "ratingCount": "1"
        }<% } %>
        }   
    </script>

        <% } %>

            <style scoped>
                .nav-link {
                    color: inherit;
                    transition: color 0.2s;
                }

                .nav-link:hover {
                    color: #2563eb;
                }

                .mobile-link {
                    display: flex;
                    align-items: center;
                    gap: 0.75rem;
                    transition: color 0.2s;
                }

                .mobile-link:hover {
                    color: #2563eb;
                }

                .footer-title {
                    color: #ffffff;
                    font-weight: 600;
                    margin-bottom: 1rem;
                }

                .footer-list li {
                    color: #94a3b8;
                    font-size: 0.875rem;
                    transition: color 0.2s;
                }

                .footer-list li:hover {
                    color: #ffffff;
                }

                .social-icon {
                    width: 2.25rem;
                    height: 2.25rem;
                    border-radius: 9999px;
                    background-color: #1e293b;
                    display: flex;
                    align-items: center;
                    justify-content: center;
                    font-size: 0.75rem;
                    font-weight: 600;
                    cursor: pointer;
                    transition: background-color 0.2s;
                }

                .social-icon:hover {
                    background-color: #2563eb;
                }

                .fade-enter-active,
                .fade-leave-active {
                    transition: opacity 0.2s ease;
                }

                .fade-enter-from,
                .fade-leave-to {
                    opacity: 0;
                }

                .slide-enter-active,
                .slide-leave-active {
                    transition: transform 0.25s ease;
                }

                .slide-enter-from,
                .slide-leave-to {
                    transform: translateX(100%);
                }
            </style>
</head>

<body>
    <% if (guide) { %>
        <div class="bg-gray-50">
            <!-- Navigation Overlay -->
            <div
                class="relative top-0 left-0 right-0 z-50 bg-white/80 backdrop-blur-md border-b border-gray-100 lg:hidden">
                <div class="px-4 py-3 flex items-center justify-between">
                    <a href="/tour-guides" class="p-2 hover:bg-gray-100 rounded-full transition-colors">
                        <svg class="w-5 h-5 text-slate-700" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                d="M10 19l-7-7m0 0l7-7m-7 7h18"></path>
                        </svg>
                    </a>
                    <h2 class="text-sm font-bold text-slate-900 truncate max-w-[200px]">
                        <%= guide.title %>
                    </h2>
                    <button class="p-2 hover:bg-gray-100 rounded-full transition-colors">
                        <svg class="w-5 h-5 text-slate-700" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                d="M8.684 13.342C8.886 12.938 9 12.482 9 12c0-.482-.114-.938-.316-1.342m0 2.684a3 3 0 110-2.684m0 2.684l6.632 3.316m-6.632-6l6.632-3.316m0 0a3 3 0 105.367-2.684 3 3 0 00-5.367 2.684zm0 9.316a3 3 0 105.368 2.684 3 3 0 00-5.368-2.684z">
                            </path>
                        </svg>
                    </button>
                </div>
            </div>

            <!-- Main Content Area -->
            <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pt-5">
                <!-- Breadcrumbs -->
                <nav class="hidden lg:flex items-center gap-2 text-sm text-slate-400 mb-8">
                    <a href="/" class="hover:text-blue-600 transition-colors">Home</a>
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
                    </svg>
                    <a href="/tour-guides" class="hover:text-blue-600 transition-colors">Tour Guides</a>
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
                    </svg>
                    <span class="text-slate-900 font-medium">
                        <%= guide.title %>
                    </span>
                </nav>

                <div class="grid grid-cols-1 lg:grid-cols-12 gap-12">
                    <!-- Left Column: Media & Core Info -->
                    <div class="lg:col-span-8">
                        <!-- Hero Image Gallery Style -->
                        <section
                            class="relative rounded-[2.5rem] overflow-hidden bg-slate-200 w-full max-h-[75vh] shadow-2xl shadow-blue-900/10 mb-10">
                            
                            <img 
                                src="<%= guide.cover_image %>" 
                                alt="<%= guide.title %>"
                                class="w-full h-auto max-h-[75vh] object-contain md:object-cover transform hover:scale-105 transition-transform duration-700">
                            
                            <div
                                class="absolute inset-0 bg-gradient-to-t from-black/80 via-black/20 to-transparent flex items-end">
                                <div class="p-8 md:p-12 w-full">
                                    <div class="flex flex-wrap items-center gap-3 mb-4">
                                        <span
                                            class="px-3 py-1 rounded-full bg-blue-600 text-white text-xs font-bold uppercase tracking-wider">
                                            <%= guide.specialty || 'Tour Guide' %>
                                        </span>
                                        <% if (guide.is_premium) { %>
                                            <span
                                                class="px-3 py-1 rounded-full bg-emerald-400 text-slate-900 text-xs font-bold uppercase tracking-wider">
                                                Verified
                                            </span>
                                        <% } %>
                                    </div>
                                    <h1 class="text-3xl md:text-5xl font-black text-white leading-tight">
                                        <%= guide.title %>
                                    </h1>
                                </div>
                            </div>
                        </section>

                        <!-- Quick Stats Row -->
                        <div class="grid grid-cols-2 md:grid-cols-4 gap-4 mb-12">
                            <div
                                class="bg-white p-5 rounded-3xl border border-slate-100 shadow-sm flex items-center gap-4">
                                <div class="w-10 h-10 rounded-2xl bg-blue-50 flex items-center justify-center">
                                    <svg class="w-5 h-5 text-blue-600" fill="none" stroke="currentColor"
                                        viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                            d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z">
                                        </path>
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                            d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path>
                                    </svg>
                                </div>
                                <div>
                                    <p class="text-[10px] font-bold text-slate-400 uppercase tracking-tight">Location
                                    </p>
                                    <p class="text-sm font-bold text-slate-900">
                                        <%= guide.municipality %>
                                    </p>
                                </div>
                            </div>
                            <div
                                class="bg-white p-5 rounded-3xl border border-slate-100 shadow-sm flex items-center gap-4">
                                <div class="w-10 h-10 rounded-2xl bg-amber-50 flex items-center justify-center">
                                    <svg class="w-5 h-5 text-amber-500 fill-amber-500" fill="currentColor"
                                        viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                            d="M11.049 2.927c.3-.921 1.603-.921 1.902 0l1.519 4.674a1 1 0 00.95.69h4.915c.969 0 1.371 1.24.588 1.81l-3.976 2.888a1 1 0 00-.363 1.118l1.518 4.674c.3.922-.755 1.688-1.538 1.118l-3.976-2.888a1 1 0 00-1.176 0l-3.976 2.888c-.783.57-1.838-.197-1.538-1.118l1.518-4.674a1 1 0 00-.363-1.118l-3.976-2.888c-.784-.57-.38-1.81.588-1.81h4.914a1 1 0 00.951-.69l1.519-4.674z">
                                        </path>
                                    </svg>
                                </div>
                                <div>
                                    <p class="text-[10px] font-bold text-slate-400 uppercase tracking-tight">Rating</p>
                                    <p class="text-sm font-bold text-slate-900">
                                        <%= guide.rating ? guide.rating.toFixed(1) : 'N/A' %>
                                    </p>
                                </div>
                            </div>
                            <div
                                class="bg-white p-5 rounded-3xl border border-slate-100 shadow-sm flex items-center gap-4">
                                <div class="w-10 h-10 rounded-2xl bg-emerald-50 flex items-center justify-center">
                                    <svg class="w-5 h-5 text-emerald-600" fill="none" stroke="currentColor"
                                        viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                            d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z">
                                        </path>
                                    </svg>
                                </div>
                                <div>
                                    <p class="text-[10px] font-bold text-slate-400 uppercase tracking-tight">Rate
                                    </p>
                                    <p class="text-sm font-bold text-slate-900">
                                        <%= guide.pricing_lowest ? '₱' + guide.pricing_lowest + '/hr' : 'Contact' %>
                                    </p>
                                </div>
                            </div>
                            <div
                                class="bg-white p-5 rounded-3xl border border-slate-100 shadow-sm flex items-center gap-4">
                                <div class="w-10 h-10 rounded-2xl bg-purple-50 flex items-center justify-center">
                                    <svg class="w-5 h-5 text-purple-600" fill="none" stroke="currentColor"
                                        viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                            d="M21 13.255A23.931 23.931 0 0112 15c-3.183 0-6.22-.62-9-1.745M16 6V4a2 2 0 00-2-2h-4a2 2 0 00-2 2v2m4 6h.01M5 20h14a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path>
                                    </svg>
                                </div>
                                <div>
                                    <p class="text-[10px] font-bold text-slate-400 uppercase tracking-tight">Experience</p>
                                    <p class="text-sm font-bold text-slate-900 truncate">
                                        <%= guide.experience_years || '5+' %> Years
                                    </p>
                                </div>
                            </div>
                        </div>

                        <!-- Bio Section -->
                        <article class="prose prose-slate max-w-none mb-12">
                            <div class="flex items-center gap-4 mb-6">
                                <h2 class="text-2xl font-extrabold text-slate-900">About <%= guide.title %>
                                </h2>
                                <div class="h-px flex-1 bg-slate-100"></div>
                            </div>
                            <p id="bio"
                                class="text-lg text-slate-600 leading-relaxed first-letter:text-5xl first-letter:font-black first-letter:text-blue-600 first-letter:mr-3 first-letter:float-left">
                                <%= guide.description %>
                            </p>
                        </article>

                        <!-- Specialties -->
                        <% if (guide.activity_tags && guide.activity_tags.length) { %>
                            <section class="mb-12">
                                <h3 class="text-lg font-bold text-slate-900 mb-6 flex items-center gap-2">
                                    <svg class="w-5 h-5 text-blue-600" fill="none" stroke="currentColor"
                                        viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                            d="M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z">
                                        </path>
                                    </svg>
                                    Specialties
                                </h3>
                                <div class="flex flex-wrap gap-3">
                                    <% guide.activity_tags.forEach(function(specialty) { %>
                                        <a href="/tour-guides?specialty=<%= encodeURIComponent(specialty) %>"
                                            class="px-5 py-2.5 bg-white border border-slate-200 text-slate-700 rounded-2xl text-sm font-semibold hover:border-blue-600 hover:text-blue-600 hover:shadow-lg hover:shadow-blue-900/5 transition-all">
                                            <%= specialty %>
                                        </a>
                                        <% }); %>
                                </div>
                            </section>
                            <% } %>

                                <!-- Languages -->
                                <% if (guide.activity_tags && guide.activity_tags.length) { %>
                                    <section class="mb-12">
                                        <h3 class="text-lg font-bold text-slate-900 mb-6 flex items-center gap-2">
                                            <svg class="w-5 h-5 text-blue-600" fill="none" stroke="currentColor"
                                                viewBox="0 0 24 24">
                                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                                    d="M3 5h12M9 3v2m1.048 9.5A18.022 18.022 0 016.412 9m6.088 9h7M11 21l5-10 5 10M12.751 5C11.783 10.77 8.07 15.61 3 18.129">
                                                </path>
                                            </svg>
                                            Languages Spoken
                                        </h3>
                                        <div class="flex flex-wrap gap-3">
                                            <% guide.activity_tags.forEach(function(language) { %>
                                                <span
                                                    class="px-5 py-2.5 bg-slate-100 text-slate-700 rounded-2xl text-sm font-semibold">
                                                    <%= language %>
                                                </span>
                                                <% }); %>
                                        </div>
                                    </section>
                                    <% } %>
                    </div>

                    <!-- Right Column: Sidebar -->
                    <div class="lg:col-span-4 space-y-8">
                        <aside class="sticky top-24">
                            <div
                                class="bg-white rounded-[2rem] border border-slate-100 shadow-2xl shadow-slate-200/50 p-8">
                                <h3 class="text-xl font-bold text-slate-900 mb-6">Book This Guide</h3>

                                <div class="space-y-6">
                                    <% if (guide.contact_info && guide.contact_info.phone) { %>
                                        <div class="flex items-start gap-4">
                                            <div
                                                class="w-10 h-10 rounded-xl bg-slate-50 flex items-center justify-center shrink-0">
                                                <svg class="w-5 h-5 text-slate-600" fill="none" stroke="currentColor"
                                                    viewBox="0 0 24 24">
                                                    <path stroke-linecap="round" stroke-linejoin="round"
                                                        stroke-width="2"
                                                        d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z">
                                                    </path>
                                                </svg>
                                            </div>
                                            <div>
                                                <p class="text-xs font-bold text-slate-400 uppercase">Phone</p>
                                                <p class="text-sm font-semibold text-slate-900">
                                                    <%= guide.contact_info.phone %>
                                                </p>
                                            </div>
                                        </div>
                                        <% } %>

                                            <% if (guide.contact_info && guide.contact_info.email) { %>
                                                <div class="flex items-start gap-4">
                                                    <div
                                                        class="w-10 h-10 rounded-xl bg-slate-50 flex items-center justify-center shrink-0">
                                                        <svg class="w-5 h-5 text-slate-600" fill="none"
                                                            stroke="currentColor" viewBox="0 0 24 24">
                                                            <path stroke-linecap="round" stroke-linejoin="round"
                                                                stroke-width="2"
                                                                d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z">
                                                            </path>
                                                        </svg>
                                                    </div>
                                                    <div>
                                                        <p class="text-xs font-bold text-slate-400 uppercase">Email</p>
                                                        <p class="text-sm font-semibold text-slate-900">
                                                            <%= guide.contact_info.email %>
                                                        </p>
                                                    </div>
                                                </div>
                                                <% } %>

                                                    <div class="pt-6 border-t border-slate-50 space-y-4">
                                                        <button
                                                            class="w-full bg-blue-600 hover:bg-blue-700 text-white font-bold py-4 rounded-2xl shadow-lg shadow-blue-200 transition-all flex items-center justify-center gap-2">
                                                            Book Now
                                                        </button>
                                                        <button
                                                            class="w-full bg-white hover:bg-slate-50 text-slate-900 border border-slate-200 font-bold py-4 rounded-2xl transition-all">
                                                            Send Message
                                                        </button>
                                                    </div>
                                </div>

                                <!-- Social Links -->
                                <div class="flex items-center justify-center gap-4 mt-8">
                                    <% if (guide.social_links && guide.social_links.facebook) { %>
                                        <a href="<%= guide.social_links.facebook %>"
                                            class="w-10 h-10 rounded-full bg-slate-100 flex items-center justify-center text-slate-600 hover:bg-blue-50 hover:text-blue-600 transition-all">
                                            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
                                                <path
                                                    d="M22 12c0-5.523-4.477-10-10-10S2 6.477 2 12c0 4.991 3.657 9.128 8.438 9.879v-6.99h-2.54V12h2.54V9.797c0-2.506 1.492-3.89 3.777-3.89 1.094 0 2.238.195 2.238.195v2.46h-1.26c-1.243 0-1.63.771-1.63 1.562V12h2.773l-.443 2.89h-2.33v6.99C18.343 21.128 22 16.991 22 12z">
                                                </path>
                                            </svg>
                                        </a>
                                        <% } %>
                                            <% if (guide.social_links && guide.social_links.instagram) { %>
                                                <a href="<%= guide.social_links.instagram %>"
                                                    class="w-10 h-10 rounded-full bg-slate-100 flex items-center justify-center text-slate-600 hover:bg-pink-50 hover:text-pink-600 transition-all">
                                                    <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
                                                        <path
                                                            d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zM5.838 12a6.162 6.162 0 1112.324 0 6.162 6.162 0 01-12.324 0zM12 16a4 4 0 110-8 4 4 0 010 8zm4.965-10.405a1.44 1.44 0 112.881.001 1.44 1.44 0 01-2.881-.001z">
                                                        </path>
                                                    </svg>
                                                </a>
                                                <% } %>
                                </div>
                            </div>

                            <div class="mt-8 rounded-3xl overflow-hidden shadow-sm">
                                <!-- AD Slot - Replace with actual ad code -->
                                <div class="bg-slate-100 p-4 text-center text-slate-400">Advertisement</div>
                            </div>
                        </aside>
                    </div>
                </div>
            </div>
        </div>
        <% } else { %>
            <div class="min-h-screen flex items-center justify-center bg-gray-50">
                <div class="text-center px-6">
                    <div class="w-24 h-24 bg-slate-200 rounded-full flex items-center justify-center mx-auto mb-6">
                        <svg class="w-10 h-10 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                d="M18.364 18.364A9 9 0 005.636 5.636m12.728 12.728A9 9 0 015.636 5.636m12.728 12.728L5.636 5.636">
                            </path>
                        </svg>
                    </div>
                    <h2 class="text-2xl font-bold text-slate-900">Guide Not Found</h2>
                    <p class="text-slate-500 mt-2 mb-8">The guide you're looking for might have been moved or removed.
